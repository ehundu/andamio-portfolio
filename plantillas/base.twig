<!doctype html>
<html lang="{{ pagina.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pagina.url == '/' %}{{ sitio.nombre }} · {{ datos.cliente.oficio }}{% else %}{{ pagina.titulo }} · {{ sitio.nombre }}{% endif %}</title>
  {% if pagina.descripcion %}<meta name="description" content="{{ pagina.descripcion }}">{% endif %}
  {% if pagina.url != '/404.html' %}<link rel="canonical" href="{{ sitio.url }}{{ pagina.url }}">{% endif %}
  {# Al compartir una página, la imagen de su portada #}
  <meta property="og:title" content="{{ pagina.titulo }}">
  {% if pagina.descripcion %}<meta property="og:description" content="{{ pagina.descripcion }}">{% endif %}
  {% if pagina.imagen and pagina.plantilla == 'proyecto' %}<meta property="og:image" content="{{ sitio.url }}/{{ pagina.imagen }}">{% endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ version('css/estilos.css') }}">
</head>
<body>
  <a class="saltar" href="#contenido">Ir al contenido</a>
  {% include 'parciales/cabecera.twig' %}
  <main id="contenido">
    {% block cuerpo %}{% endblock %}
  </main>
  {% include 'parciales/pie.twig' %}
</body>
</html>
