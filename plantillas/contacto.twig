{% extends 'plantillas/base.twig' %}

{# Contacto: el texto de la página y, debajo, los datos de datos/cliente.yml: el correo, la ciudad y las redes #}
{% block cuerpo %}
<article class="contenedor pagina">
  <h1>{{ pagina.titulo }}</h1>
  <div class="prosa">{{ pagina.contenido }}</div>

  <ul class="contacto">
    <li><span>Correo</span> <a href="mailto:{{ datos.cliente.email }}">{{ datos.cliente.email }}</a></li>
    <li><span>Ciudad</span> {{ datos.cliente.ciudad }}</li>
    {% for red in datos.cliente.redes %}
    {% if red.enlace %}
    <li><span>{{ red.nombre }}</span> <a href="{{ red.enlace }}" target="_blank" rel="noopener noreferrer">{{ red.enlace|replace({'https://': '', 'www.': ''}) }}<span class="oculto"> (se abre en una pestaña nueva)</span></a></li>
    {% endif %}
    {% endfor %}
  </ul>
</article>
{% endblock %}
